# Copia este archivo como .env y completa los valores
APP_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ismart_horarios

# Superusuario: solo para crear la base y aplicar migraciones
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=

# Usuario con permisos mínimos que usa la API (lo crea `dart run tool/db.dart setup`)
DB_APP_USER=ismart_app_dev
DB_APP_PASSWORD=

# Llave para cifrar cédulas de pacientes y notas clínicas (mínimo 32 caracteres)
DB_ENCRYPTION_KEY=

# Contraseña común de los usuarios ficticios de prueba
DEV_SEED_PASSWORD=
